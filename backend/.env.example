# Copie para .env (que NÃO vai para o Git) e ajuste os valores.
# Os valores abaixo são DEMONSTRATIVOS para ambiente local de desenvolvimento.

# Conexão com o PostgreSQL (driver psycopg 3)
DATABASE_URL=postgresql+psycopg://bridge:bridge_dev@localhost:5432/bridge

# Pasta persistente das fotos (relativa a backend/ ou absoluta). Ignorada pelo Git.
UPLOAD_DIR=var/uploads
MAX_UPLOAD_MB=5

# Token das operações administrativas (PATCH /ocorrencias/{id}/status).
# Deixe vazio para desabilitar. Se usar, mínimo 16 caracteres e gere um valor seu, ex.:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# NUNCA coloque este token no app mobile.
ADMIN_TOKEN=

# Origens web permitidas (separadas por vírgula). O app no Expo Go não precisa de CORS.
CORS_ORIGINS=

# Modelo de IA (pasta ia_ml/, ver docs/CONTRATO_IA.md). Caminho relativo à pasta backend/.
# Vazio, arquivo ausente ou inválido = a API sobe normalmente com a análise "INDISPONIVEL".
MODELO_IA_CAMINHO=../ia_ml/artifacts/bridge_text_classifier.joblib
MODELO_IA_VERSAO=bridge-text-classifier-1.0.0

LOG_LEVEL=INFO
